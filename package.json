{
	"name": "pi-extensions-nearsyh",
	"version": "0.1.0",
	"private": false,
	"description": "Pi extension bundle: ask-question, auto-title, bash-timeout, custom-footer, custom-agents, diff, explain, mini-task, command-run, otty-integration, command-center",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension"
	],
	"pi": {
		"extensions": [
			"ask-question/index.ts",
			"auto-title/index.ts",
			"custom-footer/index.ts",
			"diff/index.ts",
			"custom-agents/index.ts",
			"explain/index.ts",
			"mini-task/index.ts",
			"bash-timeout/index.ts",
			"command-run/index.ts",
			"otty-integration/index.ts",
			"command-center/index.ts",
			"command-center/extensions/cc-highlight.ts"
		]
	},
	"scripts": {
		"lint": "bunx --bun @biomejs/biome check --write",
		"start": "bun run server.ts",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"check:fix": "biome check . --fix",
		"verify": "bun run check && bun run typecheck && bun test"
	},
	"dependencies": {
		"@pierre/diffs": "^1.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@earendil-works/pi-coding-agent": "^0.84.1",
		"@earendil-works/pi-tui": "^0.84.1",
		"@types/bun": "^1.3.14",
		"typebox": "^1.3.11",
		"typescript": "^7.0.2"
	}
}
